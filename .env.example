# این فایل را کپی کن به نام .env و مقادیر واقعی را داخلش بگذار.
# فایل .env هرگز نباید وارد Git شود (در .gitignore قرار دارد).

SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# فعلاً (فاز ۱) از SQLite استفاده می‌کنیم؛ این خط‌ها را خالی/کامنت بگذار.
# وقتی به PostgreSQL مهاجرت کردیم فقط کافیست این‌ها را پر کنی:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=restaurant_saas
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
